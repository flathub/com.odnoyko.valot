{
    "id" : "com.odnoyko.valot",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.node20",
        "org.freedesktop.Sdk.Extension.typescript"
    ],
    "command" : "com.odnoyko.valot",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--filesystem=xdg-documents:create",
        "--socket=cups"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/typescript/bin:/usr/lib/sdk/node20/bin",
        "env": {
            "GI_TYPELIB_PATH": "/app/lib/girepository-1.0"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "/share/vala"
    ],
    "modules" : [
        "shared-modules/intltool/intltool-0.51.json",
        {
            "name": "libgda",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libgda/6.0/libgda-6.0.0.tar.xz",
                    "sha256": "995f4b420e666da5c8bac9faf55e7aedbe3789c525d634720a53be3ccf27a670"
                }
            ]
        },
        {
            "name" : "valot",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/valot/app/valot.git",
                    "tag" : "v0.9.4b8",
                    "commit" : "c8706aa78eeddbc6265fe0db6e917bb303e11059"

                }
            ]
        }
    ]
}
